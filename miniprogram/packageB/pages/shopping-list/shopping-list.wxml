<view class="page">
  <view class="hero">
    <view class="hero-title">购物清单</view>
    <view class="hero-subtitle">左滑删除，右滑标记已买到</view>
  </view>

  <view class="card form-card">
    <view class="form-row">
      <input class="field name-field" placeholder="物品名称" value="{{nameInput}}" bindinput="onNameInput" maxlength="20" />
      <input class="field quantity-field" placeholder="数量" type="number" value="{{quantityInput}}" bindinput="onQuantityInput" />
      <picker class="unit-picker" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="onUnitChange">
        <view class="field unit-field">{{unitOptions[unitIndex]}}</view>
      </picker>
    </view>
    <button class="add-button" loading="{{submitting}}" bindtap="addItem">添加到清单</button>
  </view>

  <view class="card combined-section-card">
    <view class="section-header">
      <text class="section-title">待购买</text>
      <text class="section-count">{{pendingItems.length}}</text>
    </view>

    <view wx:if="{{pendingItems.length}}" class="list">
      <view
        wx:for="{{pendingItems}}"
        wx:key="id"
        wx:for-item="item"
        class="swipe-row"
        data-id="{{item.id}}"
        data-list="pending"
        bindtouchstart="onItemTouchStart"
        bindtouchmove="onItemTouchMove"
        bindtouchend="onItemTouchEnd"
        bindtouchcancel="onItemTouchCancel"
      >
        <view class="swipe-action swipe-buy">
          <text class="swipe-icon swipe-icon-check">✓</text>
        </view>
        <view class="swipe-action swipe-delete">
          <text class="swipe-icon swipe-icon-close">×</text>
        </view>
        <view class="swipe-content {{item.offsetX < 0 ? 'swipe-content-left' : ''}} {{item.offsetX > 0 ? 'swipe-content-right' : ''}}" style="transform: translateX({{item.offsetX || 0}}px);">
          <view class="item-main">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <view wx:if="{{item.source === 'auto'}}" class="source-badge">自动补货</view>
            </view>
            <text class="item-quantity">{{item.quantity}}{{item.unit}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">还没有待购买的物品</view>

    <view class="combined-divider"></view>

    <view class="section-header bought-header">
      <text class="section-title">已买到</text>
      <text class="section-count">{{boughtItems.length}}</text>
    </view>

    <view wx:if="{{boughtItems.length}}" class="list">
      <view
        wx:for="{{boughtItems}}"
        wx:key="id"
        wx:for-item="item"
        class="swipe-row"
        data-id="{{item.id}}"
        data-list="bought"
        bindtouchstart="onItemTouchStart"
        bindtouchmove="onItemTouchMove"
        bindtouchend="onItemTouchEnd"
        bindtouchcancel="onItemTouchCancel"
      >
        <view class="swipe-action swipe-unbuy">
          <text class="swipe-icon swipe-icon-return">↩</text>
        </view>
        <view class="swipe-content bought {{item.offsetX > 0 ? 'swipe-content-right' : ''}}" style="transform: translateX({{item.offsetX || 0}}px);">
          <view class="item-main">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <view wx:if="{{item.source === 'auto'}}" class="source-badge">自动补货</view>
            </view>
            <text class="item-quantity">x{{item.quantity}}{{item.unit}}</text>
          </view>
          <view class="bought-badge">已买到</view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">已买到的物品会显示在这里</view>
  </view>
</view>