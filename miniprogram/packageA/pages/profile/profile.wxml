<view class="container profile-page">

  <block wx:if="{{hasFamily}}">
  
    <view class="hero card">
      <view class="hero-top">
        <view>
          <view class="hero-label">家庭管理</view>
          <view class="hero-title-row">
            <view class="hero-title">{{familyName}}</view>
            <button class="family-name-edit-btn" bindtap="startEditFamilyName">✎</button>
          </view>
        </view>
      </view>

      <view class="family-name-edit-card" wx:if="{{isEditingFamilyName}}">
        <view class="field">
          <view class="label">家庭名称</view>
          <input
            class="input"
            value="{{familyNameDraft}}"
            placeholder="请输入家庭名称"
            bindinput="onFamilyNameInput"
          />
        </view>

        <view class="profile-actions family-name-actions">
          <button class="secondary-btn" bindtap="cancelFamilyNameEdit" disabled="{{savingFamilyName}}">取消</button>
          <button class="primary-btn" bindtap="saveFamilyNameEdit" loading="{{savingFamilyName}}" disabled="{{savingFamilyName}}">保存</button>
        </view>
      </view>

      <view class="invite-panel">
        <view class="invite-label">邀请码</view>
        <view class="invite-code">{{inviteCode}}</view>
        <view class="invite-actions">
          <button class="action-btn primary" bindtap="copyInviteCode">复制邀请码</button>
          <button class="action-btn danger" bindtap="leaveFamily">退出家庭</button>
        </view>
      </view>
    </view>

    <view class="section-title">我的资料</view>
 <view class="profile-card" wx:if="{{currentMember && !isEditingProfile}}">
  <view class="member-avatar">
    {{currentMember.avatar || "👤"}}
  </view>

  <view class="profile-text">
    <text class="profile-name">
      {{currentMember.name}}
    </text>

    <text class="role-tag">
      {{currentMember.role || "家人"}}
    </text>
  </view>

  <view class="edit-profile-btn" bindtap="startEditProfile">
    编辑资料
  </view>
</view>

<view class="profile-edit-card" wx:if="{{currentMember && isEditingProfile}}">
  <view class="field">
    <view class="label">昵称</view>
    <input
      class="input"
      value="{{memberName}}"
      placeholder="请输入昵称"
      bindinput="onMemberNameInput"
    />
  </view>

  <view class="field">
    <view class="label">头像</view>

    <picker
      range="{{memberAvatarOptions}}"
      value="{{memberAvatarIndex}}"
      bindchange="onMemberAvatarChange"
    >
      <view class="picker">
        {{memberAvatarOptions[memberAvatarIndex] || "👤"}}
      </view>
    </picker>
  </view>

  <view class="field">
    <view class="label">角色</view>

    <picker
      range="{{memberRoleOptions}}"
      value="{{memberRoleIndex}}"
      bindchange="onMemberRoleChange"
    >
      <view class="picker">
        {{memberRoleOptions[memberRoleIndex] || "家人"}}
      </view>
    </picker>
  </view>

  <view class="profile-actions">
    <button
      class="secondary-btn"
      bindtap="cancelEditProfile"
      disabled="{{savingProfile}}"
    >
      取消
    </button>

    <button
      class="primary-btn"
      bindtap="saveMemberEdit"
      loading="{{savingProfile}}"
      disabled="{{savingProfile}}"
    >
      保存资料
    </button>
  </view>
</view>

    <view class="section-title">家庭成员</view>
    <view class="card member-card">
      <block wx:if="{{otherMembers.length}}">
        <view wx:for="{{otherMembers}}" wx:key="id" class="member-item member-readonly-item">
          <view class="member-avatar">{{item.avatar}}</view>
          <view class="member-meta">
            <view class="member-name-row">
              <view class="member-name">{{item.name}}</view>
              <view class="member-role">{{item.role}}</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="member-readonly-note">暂时没有其他成员。家庭成员会在他们自己的账号里分别维护。</view>
    </view>

    <view class="settings-card card">
      <view class="setting-entry" bindtap="toggleAreaSettings">
        <view class="setting-entry-text">
          <view class="setting-entry-title">冰箱区域设置</view>
          <view class="setting-entry-desc">添加、编辑和删除冰箱分区</view>
        </view>
        <view class="setting-entry-icon {{isAreaSettingsExpanded ? 'expanded' : ''}}">⌄</view>
      </view>

      <view class="settings-divider"></view>

      <view wx:if="{{isAreaSettingsExpanded}}" class="setting-body">
        <view class="section-subtitle">冰箱区域管理</view>
        <view class="area-form-card soft-card">
          <view class="form-row">
            <input
              class="area-input"
              placeholder="例如：冷藏上层、调味区"
              value="{{newAreaName}}"
              bindinput="onAreaNameInput"
            />
            <picker mode="selector" range="{{areaTypes}}" value="{{newAreaTypeIndex}}" bindchange="onAreaTypeChange">
              <view class="area-picker">{{areaTypes[newAreaTypeIndex]}}</view>
            </picker>
          </view>
          <view class="area-form-actions">
            <button class="action-btn primary full" bindtap="addArea">添加新区域</button>
          </view>
        </view>

        <view class="area-list">
          <block wx:for="{{areas}}" wx:key="id">
            <view class="area-card {{activeAreaId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="openAreaEditor">
              <view class="area-card-top">
                <view class="area-icon">{{item.icon}}</view>
              </view>
              <view class="area-name">{{item.name}}</view>
              <view class="area-type">{{item.type}}</view>
              <view class="area-actions">
                <view class="area-hint">点击编辑区域</view>
                <button class="delete-btn" data-id="{{item.id}}" catchtap="deleteArea">删除</button>
              </view>
            </view>

            <view wx:if="{{editingAreaId === item.id}}" class="card area-edit-card area-edit-inline soft-card">
              <view class="section-subtitle">编辑区域</view>
              <view class="form-row">
                <input
                  class="area-input"
                  placeholder="区域名称"
                  value="{{editingAreaName}}"
                  bindinput="onEditingAreaNameInput"
                />
                <picker mode="selector" range="{{areaTypes}}" value="{{editingAreaTypeIndex}}" bindchange="onEditingAreaTypeChange">
                  <view class="area-picker">{{areaTypes[editingAreaTypeIndex]}}</view>
                </picker>
              </view>
              <view class="area-form-actions two-btns">
                <button class="action-btn ghost full" bindtap="cancelAreaEdit">取消</button>
                <button class="action-btn primary full" bindtap="saveAreaEdit">保存修改</button>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="setting-entry" bindtap="toggleAutoReplenishSettings">
        <view class="setting-entry-text">
          <view class="setting-entry-title">自动补货设置</view>
          <view class="setting-entry-desc">库存降到阈值时自动加入购物清单</view>
        </view>
        <view class="setting-entry-icon {{isAutoReplenishExpanded ? 'expanded' : ''}}">⌄</view>
      </view>

      <view wx:if="{{isAutoReplenishExpanded}}" class="setting-body">
        <view class="auto-search-card soft-card">
          <view class="section-subtitle">搜索食材</view>
          <view class="auto-search-input-row">
            <input
              class="auto-search-input"
              placeholder="搜索库存里的食材"
              value="{{autoReplenishSearchQuery}}"
              bindinput="onAutoReplenishSearchInput"
            />
            <view wx:if="{{autoReplenishSearchLoading}}" class="auto-search-loading">搜索中…</view>
          </view>

          <view wx:if="{{autoReplenishSearchResults.length}}" class="auto-search-results">
            <view
              wx:for="{{autoReplenishSearchResults}}"
              wx:key="id"
              wx:for-item="item"
              class="auto-search-result {{autoReplenishSelectedItem && autoReplenishSelectedItem.id === item.id ? 'selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectAutoReplenishFood"
            >
              <view class="auto-search-result-main">
                <view class="auto-search-result-name">{{item.name}}</view>
                <view class="auto-search-result-meta">{{item.quantity}}{{item.unit}} · {{item.storageName || item.storage || '未设置位置'}}</view>
              </view>
              <view class="auto-search-result-arrow">›</view>
            </view>
          </view>

          <view wx:elif="{{autoReplenishSearchQuery}}" class="auto-empty-hint">没有找到匹配的食材</view>
          <view wx:else class="auto-empty-hint">搜索食材名后，从库存里选一个来设置规则</view>
        </view>

        <view wx:if="{{autoReplenishSelectedItem && !editingAutoReplenishRuleId}}" class="auto-rule-card soft-card">
          <view class="section-subtitle">定规则</view>
          <view class="auto-selected-food">
            <view class="auto-selected-food-name">{{autoReplenishSelectedItem.name}}</view>
            <view class="source-badge">{{autoReplenishSelectedItem.quantity}}{{autoReplenishSelectedItem.unit}}</view>
          </view>

          <view class="auto-rule-grid">
            <view class="auto-rule-field">
              <view class="label">库存低于</view>
              <view class="auto-inline-input">
                <input class="auto-number-input" type="number" value="{{autoReplenishThreshold}}" bindinput="onAutoReplenishThresholdInput" />
                <view class="auto-unit-text">{{autoReplenishSelectedItem.unit}}</view>
              </view>
            </view>

            <view class="auto-rule-field">
              <view class="label">自动加入</view>
              <view class="auto-inline-input">
                <input class="auto-number-input" type="number" value="{{autoReplenishQuantity}}" bindinput="onAutoReplenishQuantityInput" />
                <view class="auto-unit-text">{{autoReplenishSelectedItem.unit}}</view>
              </view>
            </view>
          </view>

          <view class="auto-rule-preview">
            库存小于等于 {{autoReplenishThreshold}}{{autoReplenishSelectedItem.unit}} 时，自动加入 {{autoReplenishQuantity}}{{autoReplenishSelectedItem.unit}} 到购物清单。
          </view>

          <view class="area-form-actions">
            <button class="action-btn primary full" bindtap="addAutoReplenishRule">开启自动补货</button>
          </view>
        </view>

        <view wx:elif="{{!editingAutoReplenishRuleId}}" class="auto-rule-card soft-card">
          <view class="auto-empty-hint">从上面的搜索结果里选择一个食材</view>
        </view>

        <view class="auto-enabled-card soft-card">
          <view class="section-subtitle">已经设置的自动补货</view>

          <view wx:if="{{autoReplenishRules.length}}" class="auto-rule-list">
            <view wx:for="{{autoReplenishRules}}" wx:key="id" wx:for-item="rule" class="auto-rule-item">
              <view class="auto-rule-info">
                <view class="auto-rule-title">{{rule.foodName}}</view>
                <view class="auto-rule-desc">库存小于等于 {{rule.threshold}}{{rule.unit}} 时，自动补货 {{rule.addQuantity}}{{rule.unit}}</view>
                <view class="auto-rule-ops">
                  <view class="auto-rule-op-btn" data-rule-id="{{rule.id}}" bindtap="startEditAutoReplenishRule">编辑</view>
                  <view class="auto-rule-op-separator"></view>
                  <view class="auto-rule-op-btn danger" data-rule-id="{{rule.id}}" bindtap="removeAutoReplenishRule">删除</view>
                </view>
              </view>

              <switch
                checked="{{rule.enabled}}"
                data-rule-id="{{rule.id}}"
                bindchange="onAutoReplenishRuleToggle"
                color="#4f9fe8"
              />
            </view>
          </view>

          <view wx:else class="auto-empty-hint">还没有开启的自动补货规则</view>
        </view>

        <view wx:if="{{editingAutoReplenishRuleId && autoReplenishSelectedItem}}" class="auto-rule-card soft-card">
          <view class="section-subtitle">编辑规则</view>
          <view class="auto-selected-food">
            <view class="auto-selected-food-name">{{autoReplenishSelectedItem.name}}</view>
            <view class="source-badge">{{autoReplenishSelectedItem.quantity}}{{autoReplenishSelectedItem.unit}}</view>
          </view>

          <view class="auto-rule-grid">
            <view class="auto-rule-field">
              <view class="label">库存低于</view>
              <view class="auto-inline-input">
                <input class="auto-number-input" type="number" value="{{autoReplenishThreshold}}" bindinput="onAutoReplenishThresholdInput" />
                <view class="auto-unit-text">{{autoReplenishSelectedItem.unit}}</view>
              </view>
            </view>

            <view class="auto-rule-field">
              <view class="label">自动加入</view>
              <view class="auto-inline-input">
                <input class="auto-number-input" type="number" value="{{autoReplenishQuantity}}" bindinput="onAutoReplenishQuantityInput" />
                <view class="auto-unit-text">{{autoReplenishSelectedItem.unit}}</view>
              </view>
            </view>
          </view>

          <view class="auto-rule-preview">
            库存小于等于 {{autoReplenishThreshold}}{{autoReplenishSelectedItem.unit}} 时，自动加入 {{autoReplenishQuantity}}{{autoReplenishSelectedItem.unit}} 到购物清单。
          </view>

          <view class="area-form-actions two-btns">
            <button class="action-btn ghost" bindtap="cancelAutoReplenishEdit">取消编辑</button>
            <button class="action-btn primary" bindtap="addAutoReplenishRule">保存修改</button>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="card empty-state-card">
      <view class="empty-state-title">你还没有加入任何家庭</view>
      <view class="empty-state-text">加入家庭后，才能看到家庭成员、邀请信息和冰箱分区管理。</view>

      <view class="empty-state-actions">
        <button class="action-btn primary full" bindtap="createFamily">创建家庭</button>
      </view>

      <view class="join-box">
        <view class="section-subtitle">加入家庭</view>
        <input
          class="area-input join-input"
          placeholder="请输入邀请码"
          value="{{joinInviteCode}}"
          bindinput="onJoinInviteInput"
        />
        <button class="action-btn ghost full join-btn" bindtap="joinFamily">加入家庭</button>
      </view>
    </view>
  </block>
</view>